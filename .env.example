# Server
PORT=3003
BASE_URL=https://pay.openclaw.ai

# Postgres (self-hosted CNPG Cluster, #6101 — replaces Supabase)
# Format: postgresql://<role>:<password>@<cluster>-rw.<namespace>.svc.cluster.local:5432/<db>
DATABASE_URL=postgresql://crypto-payments:CHANGE_ME@crypto-payments-db-rw.openclawbot.svc.cluster.local:5432/crypto_payments

# Receiving wallet addresses (where users send payments)
# One per chain — all payments go to these addresses
WALLET_BASE=0x...
WALLET_ETH=0x...
WALLET_TON=UQ...
WALLET_SOL=...

# RPC endpoints (use paid endpoints in production for reliability)
RPC_BASE=https://mainnet.base.org
RPC_ETH=https://cloudflare-eth.com
RPC_SOL=https://api.mainnet-beta.solana.com
RPC_TON=https://toncenter.com/api/v3

# Plan prices in USD (matched against on-chain stablecoin amount, 1% tolerance)
# byok is the primary $5 key; starter is an alias with the same value (#6101 §6).
# The deployment sets PRICE_BYOK=5 and does NOT set PRICE_STARTER.
PRICE_BYOK=5
PRICE_PRO=25
PRICE_MAX=100

# Telegram Bot Token (for Mini App initData verification)
# Required when running as a Telegram Mini App
TELEGRAM_BOT_TOKEN=

# Shared API key (for bot-to-payment-service authenticated calls)
API_KEY=

# Webhook callback secret (HMAC-SHA256 signature on callback payloads)
# Set the same secret in OpenClawBot to verify callbacks
CALLBACK_SECRET=
